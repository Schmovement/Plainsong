+
+/* Phase 3A: song info editor */
+.meta-form {
+  display: grid;
+  gap: 4px
+}
+
+.meta-l {
+  font: 500 12px var(--f-mono);
+  color: var(--dim);
+  margin-top: 8px
+}
+
+.meta-note {
+  margin: 12px 0 0;
+  font-size: 13px;
+  color: var(--dim)
+}
+
+.meta-orig {
+  margin-top: 10px;
+  font-size: 13px
+}
+
+.meta-dl {
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: 2px 12px;
+  margin: 4px 0 0
+}
+
+.meta-dl dt {
+  color: var(--dim)
+}
+
+.meta-dl dd {
+  margin: 0;
+  overflow-wrap: anywhere
+}
+
+.meta-err {
+  min-height: 1.2em;
+  margin-top: 8px;
+  font-size: 13px;
+  color: var(--led-r)
+}
+
+.meta-btns {
+  align-items: center;
+  flex-wrap: wrap
+}
+
+.meta-gap {
+  flex: 1
+}
+
+.meta-btns .btn[disabled] {
+  opacity: .5;
+  cursor: default
+}
